{
  "name": "sistemas-adesivos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/gerar-versao.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "validar:dados": "tsx scripts/validar-dados.ts",
    "gerar:json-schema": "tsx scripts/gerar-json-schema.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm validar:dados",
    "icons": "node scripts/gerar-icones.mjs"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.16.0",
  "engines": {
    "node": ">=24"
  }
