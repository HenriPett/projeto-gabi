  "indicacoes": [
    {
      "texto": "Diretas: compósitos fotopolimerizáveis; reparações de compósito/cerâmica e metal; selamento sob amálgama; reconstrução oclusal foto ou dual.",
      "fontes": [
        "ifu"
      ]
    },
    {
      "texto": "Indiretas: facetas; inlays, onlays, coroas e pontes de porcelana, compósito e metal; pinos endodônticos; selamento de preparos.",
      "fontes": [
        "ifu"
      ]
    }
  ],
  "contraindicacoes": [
    {
      "texto": "Histórico de reações alérgicas graves a resinas de metacrilato; capeamento pulpar direto; com resinas químicas ou duais (exceto NX3) quando a incidência de luz é insuficiente.",
      "fontes": [
        "ifu"
      ]
    }
  ],
  "protocolos": [
    {
      "id": "autocondicionante",
      "titulo": "Autocondicionante",
      "aplicaA": [
        "universal-autocondicionante"
      ],
      "fontes": [
        "ifu"
      ],
      "etapas": [
        {
          "tipo": "secagem",
          "titulo": "Preparo",
          "descricao": "Preparar a cavidade, lavar bem com spray de água e secar com jatos de ar seco, sem dessecar.",
          "parametros": [],
          "fontes": [
            "ifu"
          ]
        },
        {
          "tipo": "aplicacao-adesivo",
          "titulo": "Aplicação do adesivo",
          "descricao": "Agitar o frasco levemente (vigorosamente por 10 s no primeiro uso) e colocar 2 a 3 gotas em bloco de mistura. Com pincel descartável, aplicar quantidade generosa no esmalte/dentina, esfregando com movimento de escovação.",
          "parametros": [
            {
              "tipo": "friccao",
              "texto": "escovação 20 s"
            }
          ],
          "fontes": [
            "ifu"
          ]
        },
        {
          "tipo": "evaporacao-solvente",
          "titulo": "Secagem do adesivo",
          "descricao": "Secar com leve jato de ar e depois jato médio, com ar sem óleo. A superfície deve ficar brilhante e uniforme; se não, repetir aplicação e secagem.",
          "parametros": [
            {
              "tipo": "jato-de-ar",
              "texto": "leve → médio, pelo menos 5 s"
            }
