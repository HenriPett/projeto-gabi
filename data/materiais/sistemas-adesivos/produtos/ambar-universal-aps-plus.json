  "indicacoes": [
    {
      "texto": "Todas as classes de restaurações com compósitos (classes I, II, III, IV e V).",
      "fontes": [
        "ifu"
      ]
    },
    {
      "texto": "Cimentação adesiva (em adição ao cimento resinoso) de peças protéticas (pinos/núcleos, coroas, onlays/inlays, facetas etc.) de fibra de vidro, cerômero, cerâmica, resina e metal.",
      "fontes": [
        "ifu"
      ]
    },
    {
      "texto": "Reparos adesivos em cerâmica e compósitos.",
      "fontes": [
        "ifu"
      ]
    },
    {
      "texto": "Uso como primer para metais ou cerâmica.",
      "fontes": [
        "ifu"
      ]
    }
  ],
  "contraindicacoes": [
    {
      "texto": "Não utilizar em paciente alérgico a alguma das substâncias da composição.",
      "fontes": [
        "ifu"
      ]
    }
  ],
  "protocolos": [
    {
      "id": "autocondicionante",
      "titulo": "Autocondicionante",
      "aplicaA": [
        "universal-autocondicionante"
      ],
      "fontes": [
        "ifu"
      ],
      "etapas": [
        {
          "tipo": "aplicacao-adesivo",
          "titulo": "1ª camada do adesivo",
          "descricao": "Sem condicionamento ácido prévio em esmalte ou dentina. Dispensar o adesivo em pote Dappen ou diretamente em microaplicador descartável. Aplicar a primeira camada (uma gota) nas superfícies levemente umedecidas, friccionando vigorosamente o microaplicador saturado.",
          "parametros": [
            {
              "tipo": "camadas",
              "texto": "1ª de 2 camadas (1 gota por camada)"
            },
            {
              "tipo": "friccao",
              "texto": "fricção vigorosa 10 s"
            }
          ],
          "fontes": [
            "ifu"
          ]
        },
        {
          "tipo": "nova-aplicacao",
          "titulo": "2ª camada do adesivo",
          "descricao": "Aplicar a segunda camada de adesivo, com nova gota.",
          "parametros": [
            {
              "tipo": "tempo",
              "texto": "10 s"
            }
          ],
          "fontes": [
            "ifu"
          ]
        },
        {
          "tipo": "evaporacao-solvente",
          "titulo": "Evaporação do solvente",
          "descricao": "Aplicar jato de ar gentilmente para evaporar o solvente.",
          "parametros": [
            {
              "tipo": "jato-de-ar",
              "texto": "jato de ar suave 10 s"
            }
          ],
          "fontes": [
            "ifu"
          ]
        },
        {
          "tipo": "fotopolimerizacao",
