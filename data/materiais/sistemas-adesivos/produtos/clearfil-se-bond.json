  "protocolos": [
    {
      "id": "restauracoes-diretas",
      "titulo": "Restaurações diretas, selamento de cavidades e superfícies hipersensíveis",
      "aplicaA": [
        "autocondicionante-2-passos"
      ],
      "fontes": [
        "ifu"
      ],
      "etapas": [
        {
          "tipo": "outro",
          "titulo": "Condicionamento do esmalte não preparado (se houver)",
          "descricao": "Se a resina puder se estender sobre esmalte não preparado, aplicar K-ETCHANT GEL no esmalte, aguardar, lavar com água e secar. O PRIMER por si só não é suficiente para tratar esmalte não preparado.",
          "parametros": [
            {
              "tipo": "tempo",
              "texto": "10 s"
            },
            {
              "tipo": "substrato",
              "texto": "somente esmalte não preparado"
            }
          ],
          "fontes": [
            "ifu"
          ]
        },
        {
          "tipo": "aplicacao-primer",
          "titulo": "Aplicação do PRIMER",
          "descricao": "Dispensar o PRIMER no prato de mistura imediatamente antes do uso (proteger da luz e usar em até 3 minutos). Aplicar em todas as paredes da cavidade com pincel descartável e deixar reagir, evitando contato com saliva.",
          "parametros": [
            {
              "tipo": "tempo",
              "texto": "deixar reagir 20 s"
            }
          ],
          "fontes": [
            "ifu"
          ]
        },
        {
          "tipo": "evaporacao-solvente",
          "titulo": "Evaporação dos voláteis",
          "descricao": "Evaporar os ingredientes voláteis com leve jato de ar isento de óleo. Não lavar. Evitar acúmulo de PRIMER.",
          "parametros": [
            {
              "tipo": "jato-de-ar",
              "texto": "jato de ar leve"
            }
          ],
          "fontes": [
            "ifu"
          ]
        },
        {
          "tipo": "aplicacao-adesivo",
          "titulo": "Aplicação do BOND",
          "descricao": "Dispensar o BOND (proteger da luz e usar em até 3 minutos) e aplicar em toda a superfície da cavidade com pincel descartável.",
          "parametros": [],
          "fontes": [
            "ifu"
          ]
        },
        {
          "tipo": "jato-de-ar",
          "titulo": "Uniformização da película",
          "descricao": "Obter uma película de adesivo o mais uniforme possível com leve jato de ar isento de óleo. Jato forte dispersa o adesivo e prejudica a adesão.",
          "parametros": [
            {
              "tipo": "jato-de-ar",
              "texto": "jato de ar leve"
            }
          ],
          "fontes": [
            "ifu"
          ]
        },
        {
          "tipo": "fotopolimerizacao",
          "titulo": "Fotopolimerização",
          "descricao": "Fotopolimerizar o BOND.",
          "parametros": [
            {
              "tipo": "luz",
              "texto": "10 s · 400-515 nm · > 300 mW/cm²"
            }
          ],
          "fontes": [
            "ifu"
          ]
        }
      ],
      "observacoes": [
        {
          "texto": "Se a superfície tratada for contaminada, lavar com água e secar (ou limpar com álcool) e tratar novamente com PRIMER.",
          "fontes": [
            "ifu"
          ]
        },
        {
          "texto": "Armazenar refrigerado (2-8 °C) e levar à temperatura ambiente antes do uso.",
          "fontes": [
            "ifu"
          ]
        }
      ]
    }
