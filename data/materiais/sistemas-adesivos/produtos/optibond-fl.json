  "indicacoes": [
    {
      "texto": "Compósito ao esmalte e/ou dentina, reparação de compósito e de porcelana, compósito ao metal e materiais de reconstrução de núcleo.",
      "fontes": [
        "ifu"
      ]
    }
  ],
  "contraindicacoes": [
    {
      "texto": "Nenhuma conhecida (IFU). Evitar contato direto com o tecido pulpar.",
      "fontes": [
        "ifu"
      ]
    }
  ],
  "protocolos": [
    {
      "id": "condicionamento-total",
      "titulo": "Restaurações diretas (condicionamento total)",
      "aplicaA": [
        "convencional-3-passos"
      ],
      "fontes": [
        "ifu"
      ],
      "etapas": [
        {
          "tipo": "outro",
          "titulo": "Preparo",
          "descricao": "Agitar brevemente o frasco de ADESIVO antes de dispensar e colocar 1-2 gotas de PRIMER e de ADESIVO em poços separados (pincéis separados para cada um). Isolar com dique de borracha, limpar o dente não preparado com pasta sem flúor, lavar e secar.",
          "parametros": [
            {
              "tipo": "tempo",
              "texto": "agitar o adesivo 5 s"
            }
          ],
          "fontes": [
            "ifu"
          ]
        },
        {
          "tipo": "condicionamento-acido",
          "titulo": "Condicionamento ácido",
          "descricao": "Aplicar o Kerr Gel Etchant no esmalte e na dentina.",
          "parametros": [
            {
              "tipo": "tempo",
              "texto": "15 s"
            },
            {
              "tipo": "substrato",
              "texto": "esmalte e dentina"
            }
          ],
          "fontes": [
            "ifu"
          ]
        },
        {
          "tipo": "lavagem",
          "titulo": "Lavagem",
          "descricao": "Enxaguar cuidadosamente, removendo todo o condicionador.",
          "parametros": [],
          "fontes": [
            "ifu"
          ]
        },
        {
          "tipo": "secagem",
          "titulo": "Secagem",
          "descricao": "Secar delicadamente com ar limpo e isento de óleo, sem desidratar a dentina.",
          "parametros": [],
          "fontes": [
            "ifu"
          ]
        },
        {
          "tipo": "aplicacao-primer",
          "titulo": "PRIMER",
          "descricao": "Aplicar o PRIMER com pincel, esfregando suavemente sobre esmalte e dentina.",
          "parametros": [
            {
              "tipo": "friccao",
              "texto": "esfregar suavemente 15 s"
            }
          ],
          "fontes": [
            "ifu"
          ]
        },
        {
          "tipo": "jato-de-ar",
          "titulo": "Secagem do primer",
          "descricao": "Secar suavemente com ar; a dentina deve ficar levemente lustrosa.",
          "parametros": [
            {
              "tipo": "jato-de-ar",
              "texto": "suave, cerca de 5 s"
            }
          ],
          "fontes": [
            "ifu"
          ]
        },
        {
          "tipo": "aplicacao-adesivo",
          "titulo": "ADESIVO",
          "descricao": "Com um novo pincel, aplicar o ADESIVO no esmalte e na dentina, esfregando suavemente para criar uma camada fina.",
          "parametros": [
            {
              "tipo": "friccao",
              "texto": "esfregar suavemente 15 s"
            }
          ],
          "fontes": [
            "ifu"
          ]
        },
        {
          "tipo": "jato-de-ar",
          "titulo": "Secagem do adesivo",
          "descricao": "Secar suavemente com ar.",
          "parametros": [
            {
              "tipo": "jato-de-ar",
              "texto": "suave, cerca de 5 s"
            }
          ],
          "fontes": [
            "ifu"
          ]
        },
        {
          "tipo": "fotopolimerizacao",
          "titulo": "Fotopolimerização",
          "descricao": "Fotopolimerizar (LED ou halógena, mínimo 600 mW/cm², 400–520 nm).",
          "parametros": [
            {
              "tipo": "luz",
              "texto": "10 s · 600–1000 mW/cm²"
            },
            {
              "tipo": "luz",
              "texto": "5 s · > 1000 mW/cm²"
            }
          ],
          "fontes": [
            "ifu"
          ]
        }
      ],
      "observacoes": [
        {
          "texto": "Ao restaurar vários dentes, aplicar o PRIMER em todas as superfícies antes de aplicar o ADESIVO.",
          "fontes": [
            "ifu"
          ]
        }
      ]
    }
  ],
