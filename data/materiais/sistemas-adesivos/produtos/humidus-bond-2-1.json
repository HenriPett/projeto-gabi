{
  "$schema": "../../../schemas/produto-sistema-adesivo.schema.json",
  "material": "sistemas-adesivos",
  "aliases": [
    "Humidus 2.1"
  ],
  "indicacoes": [
    {
      "texto": "Condicionamento de superfícies de esmalte e dentina para selamento e como superfície de acoplamento para cimentos resinosos e materiais restauradores compatíveis com resinas compostas.",
      "fontes": [
        "ifu"
      ]
    }
  ],
  "contraindicacoes": [
    {
      "texto": "Não aplicar sobre polpas expostas ou em cavidades muito profundas sem proteção; usar com cautela em pacientes sensíveis a metacrilatos.",
      "fontes": [
        "ifu"
      ]
    }
  ],
  "protocolos": [
    {
      "id": "restauracoes",
      "titulo": "Preparo e aplicação",
      "aplicaA": [
        "convencional-2-passos"
      ],
      "fontes": [
        "ifu"
      ],
      "etapas": [
        {
          "tipo": "condicionamento-acido",
          "titulo": "Condicionamento ácido",
          "descricao": "Aplicar ácido fosfórico 37% primeiro no esmalte; após 40 s, aplicar também na dentina por mais 20 s, mantendo o ácido no esmalte.",
          "parametros": [
            {
              "tipo": "tempo",
              "texto": "esmalte 60 s (total)"
            },
            {
              "tipo": "tempo",
              "texto": "dentina 20 s"
            },
            {
              "tipo": "substrato",
              "texto": "esmalte e dentina"
            }
          ],
          "fontes": [
            "ifu"
          ]
        },
        {
          "tipo": "lavagem",
          "titulo": "Lavagem",
          "descricao": "Remover o ácido lavando copiosamente com água.",
          "parametros": [
            {
              "tipo": "tempo",
              "texto": "30 s"
            }
          ],
          "fontes": [
            "ifu"
          ]
        },
        {
          "tipo": "controle-umidade",
          "titulo": "Secagem",
          "descricao": "Secar o esmalte com jato de ar leve e distante; secar a dentina sem desidratar (papel absorvente, pressionando suavemente, sem esfregar).",
          "parametros": [],
          "fontes": [
            "ifu"
          ]
        },
        {
          "tipo": "aplicacao-adesivo",
          "titulo": "Aplicação do adesivo",
          "descricao": "Agitar bem o frasco, dispensar 1 ou 2 gotas e levar a toda a superfície ácido-atacada com microbrush ou pincel, sem esfregar. Aguardar o completo molhamento.",
          "parametros": [
            {
              "tipo": "tempo",
              "texto": "aguardar 60 s"
            },
            {
              "tipo": "friccao",
              "texto": "sem esfregar"
            }
          ],
          "fontes": [
            "ifu"
          ]
        },
        {
          "tipo": "evaporacao-solvente",
          "titulo": "Evaporação do solvente",
          "descricao": "Aplicar leve jato de ar isento de óleo para evaporar o etanol.",
          "parametros": [],
          "fontes": [
            "ifu"
          ]
        },
        {
          "tipo": "fotopolimerizacao",
          "titulo": "Fotopolimerização",
          "descricao": "Fotopolimerizar (aparelhos de baixa potência podem requerer 20 s).",
          "parametros": [
            {
              "tipo": "luz",
              "texto": "10 s · 360–490 nm · mínimo 400 mW/cm²"
            }
          ],
          "fontes": [
            "ifu"
          ]
        },
        {
          "tipo": "nova-aplicacao",
          "titulo": "2ª camada",
          "descricao": "Aplicar nova camada e polimerizar novamente.",
          "parametros": [
            {
              "tipo": "luz",
              "texto": "10 s"
            }
          ],
          "fontes": [
            "ifu"
          ]
        }
      ],
      "observacoes": [
        {
          "texto": "Na cimentação de coroas com cimento resinoso, aplicar uma única e fina camada para não prejudicar o assentamento.",
          "fontes": [
            "ifu"
          ]
        }
      ]
    }
  ],
