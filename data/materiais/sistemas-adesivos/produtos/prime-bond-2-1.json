  "indicacoes": [
    {
      "texto": "Agente de união para restaurações diretas com compósitos e compômeros, cimentação de restaurações indiretas e reparos adesivos.",
      "fontes": [
        "ifu"
      ]
    },
    {
      "texto": "Verniz adesivo sob restaurações de amálgama.",
      "fontes": [
        "ifu"
      ]
    },
    {
      "texto": "Verniz protetor para hipersensibilidade cervical.",
      "fontes": [
        "ifu"
      ]
    }
  ],
  "contraindicacoes": [
    {
      "texto": "Pacientes com histórico de reação alérgica severa a resinas de metacrilato; aplicação direta sobre a polpa (capeamento pulpar direto). Não usar com materiais que contenham eugenol.",
      "fontes": [
        "ifu"
      ]
    }
  ],
  "protocolos": [
    {
      "id": "restauracoes-diretas-compositos",
      "titulo": "Restaurações diretas com compósitos",
      "aplicaA": [
        "convencional-2-passos"
      ],
      "fontes": [
        "ifu"
      ],
      "etapas": [
        {
          "tipo": "condicionamento-acido",
          "titulo": "Condicionamento ácido",
          "descricao": "Aplicar o condicionador começando pelo esmalte e em seguida na dentina.",
          "parametros": [
            {
              "tipo": "tempo",
              "texto": "esmalte pelo menos 15 s"
            },
            {
              "tipo": "tempo",
              "texto": "dentina no máximo 15 s"
            },
            {
              "tipo": "substrato",
              "texto": "esmalte e dentina"
            }
          ],
          "fontes": [
            "ifu"
          ]
        },
        {
          "tipo": "lavagem",
          "titulo": "Lavagem",
          "descricao": "Lavar as áreas condicionadas.",
          "parametros": [
            {
              "tipo": "tempo",
              "texto": "no mínimo 15 s"
            }
          ],
          "fontes": [
            "ifu"
          ]
        },
        {
          "tipo": "controle-umidade",
          "titulo": "Controle da umidade",
          "descricao": "Remover o excesso de umidade com bolinha de algodão úmida, sem esfregar; a dentina deve ficar úmida e brilhante, sem empoçamento.",
          "parametros": [],
          "fontes": [
            "ifu"
          ]
        },
        {
          "tipo": "aplicacao-adesivo",
          "titulo": "Aplicação do adesivo",
          "descricao": "Dispensar na ponta aplicadora (ou 2 a 3 gotas em pote dappen e fechar o frasco). Aplicar quantidade generosa, molhando todas as superfícies; podem ser necessárias aplicações adicionais.",
          "parametros": [
            {
              "tipo": "tempo",
              "texto": "superfícies molhadas por 20 s"
            }
          ],
          "fontes": [
            "ifu"
          ]
        },
        {
          "tipo": "evaporacao-solvente",
          "titulo": "Remoção do excesso",
          "descricao": "Remover os excessos com breve jato de ar. A superfície deve ter brilho uniforme; se não, repetir a aplicação.",
          "parametros": [
            {
              "tipo": "jato-de-ar",
              "texto": "5 s no máximo"
            }
          ],
          "fontes": [
            "ifu"
          ]
        },
        {
          "tipo": "fotopolimerizacao",
          "titulo": "Fotopolimerização",
          "descricao": "Fotopolimerizar o Prime & Bond 2.1. A bula não informa intensidade de luz.",
          "parametros": [
            {
              "tipo": "luz",
              "texto": "10 s"
            }
          ],
          "fontes": [
            "ifu"
          ]
        },
        {
          "tipo": "nova-aplicacao",
          "titulo": "Segunda camada",
          "descricao": "Aplicar uma segunda camada sobre toda a cavidade e remover imediatamente os excessos com jato de ar. Aplicar o compósito sobre a camada não polimerizada.",
          "parametros": [
            {
              "tipo": "camadas",
              "texto": "2ª camada, não polimerizada"
            }
          ],
          "fontes": [
            "ifu"
          ]
        }
      ],
      "observacoes": [
        {
          "texto": "Restaurações extensas, com múltiplas faces e sujeitas a grande esforço mastigatório: polimerizar a segunda camada antes do restaurador.",
          "fontes": [
            "ifu"
          ]
        },
        {
          "texto": "Se houver contaminação por saliva, repetir todo o condicionamento ácido.",
          "fontes": [
            "ifu"
          ]
        }
      ]
    }
  ],
