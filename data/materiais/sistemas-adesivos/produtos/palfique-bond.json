          "fontes": [
            "ifu"
          ]
        },
        {
          "tipo": "aplicacao-adesivo",
          "titulo": "Aplicação",
          "descricao": "Dispensar 1 a 2 gotas e aplicar com aplicador descartável sobre toda a superfície a ser aderida; proteger da luz e completar a aplicação em até 5 minutos após dispensar.",
          "parametros": [
            {
              "tipo": "tempo",
              "texto": "aguardar 10 s ou mais"
            }
          ],
          "fontes": [
            "ifu"
          ]
        },
        {
          "tipo": "jato-de-ar",
          "titulo": "Secagem do adesivo",
          "descricao": "Aplicar ar suave e contínuo até a camada de adesivo deixar de se mover; usar aspirador para evitar salpicos.",
          "parametros": [
            {
              "tipo": "jato-de-ar",
              "texto": "suave, normalmente 5 s"
            }
          ],
          "fontes": [
            "ifu"
          ]
        },
        {
          "tipo": "fotopolimerizacao",
          "titulo": "Fotopolimerização",
          "descricao": "Fotopolimerizar com a ponta a 2 mm da superfície; em cavidades grandes, por segmentos.",
          "parametros": [
            {
              "tipo": "luz",
              "texto": "10 s ou mais · > 300 mW/cm²"
            }
          ],
          "fontes": [
            "ifu"
          ]
        }
      ],
      "observacoes": [
        {
          "texto": "Não use resinas compostas autopolimerizáveis com o Palfique Bond.",
          "fontes": [
            "ifu"
          ]
        }
      ]
    }
