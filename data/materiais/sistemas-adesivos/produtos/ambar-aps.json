      "fontes": [
        "ifu"
      ]
    },
    {
      "texto": "Reparos adesivos em cerâmica e compósitos.",
      "fontes": [
        "ifu"
      ]
    }
  ],
  "contraindicacoes": [
    {
      "texto": "Evitar o uso em pacientes com alergia a acrilatos/metacrilatos.",
      "fontes": [
        "ifu"
      ]
    }
  ],
  "protocolos": [
    {
      "id": "restauracoes-diretas-e-indiretas",
      "titulo": "Restaurações diretas e indiretas",
      "aplicaA": [
        "convencional-2-passos"
      ],
      "fontes": [
        "ifu"
      ],
      "etapas": [
        {
          "tipo": "condicionamento-acido",
          "titulo": "Condicionamento ácido",
          "descricao": "Aplicar ácido fosfórico 37% em esmalte e dentina, de acordo com o tipo de preparo.",
          "parametros": [
            {
              "tipo": "tempo",
              "texto": "15 s"
            },
            {
              "tipo": "substrato",
              "texto": "esmalte e dentina"
            }
          ],
          "fontes": [
            "ifu"
          ]
        },
        {
          "tipo": "lavagem",
          "titulo": "Lavagem",
          "descricao": "Lavar a superfície com água.",
          "parametros": [],
          "fontes": [
            "ifu"
          ]
        },
        {
          "tipo": "controle-umidade",
          "titulo": "Controle da umidade",
          "descricao": "Secar a cavidade deixando a dentina hidratada, porém sem acúmulo de água na superfície. Se for preciso reidratar a dentina, usar bolinhas de algodão umedecidas com água destilada ou clorexidina.",
          "parametros": [],
          "fontes": [
            "ifu"
          ]
        },
        {
          "tipo": "aplicacao-adesivo",
          "titulo": "1ª camada do adesivo",
          "descricao": "Dispensar o adesivo em pote Dappen ou diretamente em microaplicador descartável. Aplicar a primeira camada (uma gota) friccionando vigorosamente o microaplicador saturado sobre as superfícies levemente umedecidas.",
          "parametros": [
            {
              "tipo": "camadas",
              "texto": "1ª de 2 camadas (1 gota por camada)"
            },
            {
              "tipo": "friccao",
              "texto": "fricção vigorosa 10 s"
            }
          ],
          "fontes": [
            "ifu"
          ]
        },
        {
          "tipo": "nova-aplicacao",
          "titulo": "2ª camada do adesivo",
          "descricao": "Aplicar a segunda camada de adesivo.",
          "parametros": [
            {
              "tipo": "tempo",
              "texto": "10 s"
            }
          ],
          "fontes": [
            "ifu"
          ]
        },
        {
          "tipo": "evaporacao-solvente",
          "titulo": "Evaporação do solvente",
          "descricao": "Aplicar jato de ar gentilmente para evaporar o solvente.",
          "parametros": [
            {
              "tipo": "jato-de-ar",
              "texto": "jato de ar suave 10 s"
            }
          ],
          "fontes": [
            "ifu"
          ]
        },
        {
          "tipo": "fotopolimerizacao",
          "titulo": "Fotopolimerização",
          "descricao": "Fotopolimerizar o adesivo com luz azul.",
          "parametros": [
            {
              "tipo": "luz",
              "texto": "10 s · potência acima de 450 mW/cm²"
            }
          ],
          "fontes": [
            "ifu"
          ]
        }
      ],
      "observacoes": [
        {
          "texto": "Para cimentação de pinos pré-fabricados a IFU traz protocolo próprio: ácido no conduto por 15 s, duas camadas friccionadas por 10 s, jato de ar 10 s e fotopolimerização por 20 s.",
          "fontes": [
            "ifu"
          ]
        },
        {
          "texto": "Antes de aplicar o adesivo, a dentina deve estar levemente brilhante (úmida), mas não molhada. Evitar excesso de adesivo e de jatos de ar.",
          "fontes": [
            "ifu"
          ]
        }
      ]
    }
