{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "fontes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "ifu",
              "ficha-tecnica",
              "fds",
              "site-fabricante",
              "embalagem",
              "literatura",
              "loja",
              "outro"
            ]
          },
          "titulo": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "acessadoEm": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "versao": {
            "type": "string"
          },
          "observacao": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "tipo",
          "titulo",
          "url",
          "acessadoEm"
        ]
      }
    },
    "grupos": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "convencional",
          "autocondicionante",
          "universal"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "explicacao": {
            "type": "object",
            "properties": {
              "texto": {
                "type": "string",
                "minLength": 1
              },
              "fontes": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              }
            },
            "required": [
              "texto",
              "fontes"
            ]
          }
        },
        "required": [
          "explicacao"
        ]
      }
    },
    "subcategorias": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "convencional-2-passos",
          "convencional-3-passos",
          "autocondicionante-1-passo",
          "autocondicionante-2-passos",
          "universal-condicionamento-seletivo",
          "universal-condicionamento-total",
          "universal-autocondicionante"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "explicacao": {
            "type": "object",
            "properties": {
              "texto": {
                "type": "string",
                "minLength": 1
              },
              "fontes": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              }
            },
            "required": [
              "texto",
              "fontes"
            ]
          }
        },
        "required": [
          "explicacao"
        ]
      }
    }
  },
  "required": [
    "fontes",
    "grupos",
    "subcategorias"
  ]
}
