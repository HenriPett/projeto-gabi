{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "titulo": {
      "type": "string",
      "minLength": 1
    },
    "resumo": {
      "type": "string",
      "minLength": 1
    },
    "ordem": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "secoes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "titulo": {
            "type": "string",
            "minLength": 1
          },
          "paragrafos": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "texto": {
                  "type": "string",
                  "minLength": 1
                },
                "fontes": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                  }
                }
              },
              "required": [
                "texto",
                "fontes"
              ]
            }
          }
        },
        "required": [
          "paragrafos"
        ]
      }
    },
    "fontes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "ifu",
              "ficha-tecnica",
              "fds",
              "site-fabricante",
              "embalagem",
              "literatura",
              "loja",
              "outro"
            ]
          },
          "titulo": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "acessadoEm": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "versao": {
            "type": "string"
          },
          "observacao": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "tipo",
          "titulo",
          "url",
          "acessadoEm"
        ]
      }
    },
    "relacionados": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "revisao": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "rascunho",
            "publicado"
          ]
        },
        "atualizadoEm": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "responsavel": {
          "type": "string"
        },
        "notas": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "atualizadoEm"
      ]
    }
  },
  "required": [
    "slug",
    "titulo",
    "resumo",
    "ordem",
    "secoes",
    "fontes",
    "revisao"
  ]
}
