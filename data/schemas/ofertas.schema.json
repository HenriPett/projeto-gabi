{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "produtoId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "ofertas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lojaId": {
            "type": "string",
            "enum": [
              "dental-cremer",
              "dental-speed",
              "dental-med-sul"
            ]
          },
          "apresentacaoId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "status": {
            "type": "string",
            "enum": [
              "disponivel",
              "indisponivel",
              "nao-encontrado"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "tituloNaLoja": {
            "type": "string"
          },
          "skuLoja": {
            "type": "string"
          },
          "precos": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "tipo": {
                  "type": "string",
                  "enum": [
                    "padrao",
                    "pix",
                    "boleto"
                  ]
                },
                "centavos": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "condicao": {
                  "type": "string"
                }
              },
              "required": [
                "tipo",
                "centavos"
              ]
            }
          },
          "consultadoEm": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "observacao": {
            "type": "string"
          }
        },
        "required": [
          "lojaId",
          "apresentacaoId",
          "status",
          "consultadoEm"
        ]
      }
    }
  },
  "required": [
    "produtoId",
    "ofertas"
  ]
}
