# Copie para .env.local (não versionado) e ajuste. Nunca commite segredos.
# Na Vercel, configure em Project → Settings → Environment Variables.

# Opcional — URL pública canônica, sem barra final. Só é necessária com domínio próprio.
# Sem ela: produção usa VERCEL_PROJECT_PRODUCTION_URL (<projeto>.vercel.app),
# previews usam VERCEL_URL e local usa http://localhost:3000 (src/lib/site.ts).
# NEXT_PUBLIC_SITE_URL=

# Opcional — força exibir (1) ou esconder (0) produtos em rascunho.
# Padrão: aparecem em dev/preview, nunca quando VERCEL_ENV=production.
# INCLUIR_RASCUNHOS=

# Opcional — pasta de dados alternativa (testes/E2E usam tests/fixtures/dados).
# DADOS_DIR=

# Fornecidas automaticamente pela Vercel (não definir à mão):
# VERCEL_ENV, VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL, VERCEL_GIT_COMMIT_SHA,
# VERCEL_GIT_COMMIT_REF, NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA
