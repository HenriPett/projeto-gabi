# Copie para .env.local (não versionado) e ajuste. Nunca commite segredos.
# Na Vercel, configure em Project → Settings → Environment Variables.

# URL pública canônica do site, sem barra final (usada no robots.txt).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional — força exibir (1) ou esconder (0) produtos em rascunho.
# Padrão: aparecem em dev/preview, nunca quando VERCEL_ENV=production.
# INCLUIR_RASCUNHOS=

# Opcional — pasta de dados alternativa (testes/E2E usam tests/fixtures/dados).
# DADOS_DIR=

# Fornecidas automaticamente pela Vercel (não definir à mão):
# VERCEL_ENV, VERCEL_GIT_COMMIT_SHA, VERCEL_GIT_COMMIT_REF, NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA
